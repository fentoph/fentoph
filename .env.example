# ==============================================================================
# FENTOPH ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure each variable for your environment.
# NEVER commit .env to version control!
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=production

# Security & CORS (Comma-separated exact origins, NO wildcards in production!)
ALLOWED_ORIGINS=https://fentoph.com,https://app.fentoph.com,https://admin.fentoph.com
# For local development: http://localhost:5173,http://127.0.0.1:5173

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
SESSION_SECRET=replace_with_64_character_hex_string_from_openssl
JWT_SECRET=replace_with_64_character_hex_string_from_openssl
COOKIE_SECRET=replace_with_64_character_hex_string_from_openssl

# Admin Initial Provisioning (Used strictly by CLI bootstrap script)
ADMIN_BOOTSTRAP_TOKEN=replace_with_secure_random_token_for_first_admin_setup

# Database Configuration
# Supported drivers: sqlite (default/embedded), postgres (high-scale production)
DB_DRIVER=sqlite
DB_PATH=./server/data/fentoph.db

# If DB_DRIVER=postgres, supply connection URI:
DATABASE_URL=postgres://fentoph_user:secure_db_pass@127.0.0.1:5432/fentoph_prod

# Email Service Driver (options: logger for dev, smtp for production)
EMAIL_SERVICE_DRIVER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_resend_api_key
EMAIL_FROM=Fentoph Security <security@fentoph.com>

# AI Assistant Proxy (internal knowledge engine by default; or gemini)
AI_PROVIDER=internal
AI_API_KEY=
